# Public Google OAuth Web Client ID (not a client secret).
VITE_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Public API key restricted to the production HTTP referrer and Google Picker API.
VITE_GOOGLE_API_KEY=YOUR_RESTRICTED_GOOGLE_API_KEY

# Numeric Google Cloud project number used by Google Picker.
VITE_GOOGLE_APP_ID=YOUR_GOOGLE_CLOUD_PROJECT_NUMBER
