{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infection-control-amr-tockph",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infection-control-amr-tockph",
      "database_id": "7c21ac3f-d624-426f-9f6d-9172d2343ce8",
      "migrations_dir": "migrations"
    }
  ]
}
